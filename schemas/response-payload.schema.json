{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-contract.example.invalid/v1/response-payload.schema.json",
  "title": "Decrypted Relay Response Payload v1.1",
  "type": "object",
  "additionalProperties": false,
  "required": ["generatedAtMilliseconds", "requestNonce", "snapshots"],
  "properties": {
    "generatedAtMilliseconds": { "type": "integer", "minimum": 0 },
    "requestNonce": { "type": "string", "minLength": 16, "maxLength": 100 },
    "snapshots": { "type": "array" },
    "compression": { "enum": ["zlib", "none"] },
    "sections": {
      "type": "object",
      "additionalProperties": { "$ref": "section.schema.json" }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string", "minLength": 1, "maxLength": 64 },
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      }
    }
  }
}
