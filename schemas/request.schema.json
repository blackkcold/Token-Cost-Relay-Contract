{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://relay-contract.example.invalid/v1/request.schema.json",
  "title": "Relay Query Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["requestId", "envelope"],
  "properties": {
    "requestId": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,100}$" },
    "envelope": { "$ref": "envelope.schema.json" }
  }
}
